# build output
/build/
/Choosen.exe
/releases/
*.obj
*.pdb
*.ilk
*.tmp

# the owner's rating data never goes into history
/data/

# local dev instance + test fixtures that must not be committed
/dev/run/
.venv/
/dev/bench/
/dev/runbench/

# Android build output and machine-specific settings
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/.idea/
*.apk

# iOS: the Xcode project is generated from ios/project.yml; V3 is copied in by the build
/ios/Choosen.xcodeproj/
/ios/Choosen/v3/
/ios/build/
*.ipa
